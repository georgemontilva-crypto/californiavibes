# MySQL. En Railway: ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://user:password@host:3306/railway

# Firma de la sesion del admin. Cadena larga y aleatoria.
JWT_SECRET=

# Secreto para crear el PRIMER admin. Borrar de Railway despues de crearlo.
ADMIN_SETUP_TOKEN=

# true = carga los 18 productos al arrancar. Borrar de Railway despues del primer deploy.
SEED_CATALOG=

# Cloudflare R2 (PDF de laboratorio, fotos de producto y videos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Opcional: cobro con tarjeta (Authorize.net). Sin esto los pedidos quedan "Awaiting payment".
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_CLIENT_KEY=
AUTHNET_ENV=production

# Opcional: emails de pedidos (cliente y equipo) y de Contact Us (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
